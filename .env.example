# ─────────────────────────────────────────────────────────────
# App identity  (never hardcode the product name in source)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Futari"
NEXT_PUBLIC_APP_TAGLINE="二人の会話を、未来につなげる。"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ja"

# ─────────────────────────────────────────────────────────────
# Demo mode
# With both flags true the whole product runs with no external
# credentials: in-memory couple data + deterministic AI output.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true
AI_MOCK_MODE=true

# ─────────────────────────────────────────────────────────────
# Supabase  (required only when NEXT_PUBLIC_DEMO_MODE=false)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SERVER ONLY. Never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# ─────────────────────────────────────────────────────────────
# AI  (required only when AI_MOCK_MODE=false)
# The app is vendor-neutral: pick a provider, the abstraction
# layer in src/lib/ai handles the rest.
# ─────────────────────────────────────────────────────────────
AI_PROVIDER="mock"          # mock | openai | anthropic
AI_MODEL=""                 # e.g. gpt-4.1-mini / claude-sonnet-4-5
AI_FALLBACK_PROVIDER="mock" # used when the primary provider fails
AI_FALLBACK_MODEL=""
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────
# 32+ random bytes, base64. Used to hash invitation tokens.
INVITATION_TOKEN_PEPPER="dev-only-change-me-in-production-0000000000"
